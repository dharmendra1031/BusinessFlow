    }
  },
  "project": {
    "Title": "Project Amount",
    "Columns": {
      "customerCode": "string",
      "customerName": "string",
      "mobileNumber": "string",
      "companyName": "string",
      "leadStatus": "string",
      "projectAmount": "decimal",
      "createdAtUtc": "date"
    }
  },
  "created": {
    "Title": "Customer Creation",
    "Columns": {
      "customerCode": "string",
      "customerName": "string",
      "mobileNumber": "string",
      "companyName": "string",
      "leadStatus": "string",
      "projectAmount": "decimal",
      "createdAtUtc": "date"
    }
  },
  "followups": {
    "Title": "Follow-up Report",
    "Columns": {
      "customerCode": "string",
      "customerName": "string",
      "nextFollowUpDate": "date",
      "followUpDate": "date",
      "remarks": "string"
    }
  },
  "overdue": {
    "Title": "Overdue Follow-ups",
    "Columns": {
      "customerCode": "string",
      "customerName": "string",
      "nextFollowUpDate": "date",
      "followUpDate": "date",
      "remarks": "string"
    }
  },
  "user-customers": {
    "Title": "User-wise Customers",
    "Columns": {
      "userName": "string",
      "customerCount": "long",
      "projectAmount": "decimal"
    }
  },
  "user-project": {
    "Title": "User-wise Project Amount",
    "Columns": {
      "userName": "string",
      "customerCount": "long",
      "projectAmount": "decimal"
    }
  },
  "source-summary": {
    "Title": "Source-wise Lead Summary",
    "Columns": {
      "sourceId": "long",
      "sourceName": "string",
      "leadCount": "long",
      "qualifiedCount": "long",
      "wonCount": "long",
      "conversionPercent": "decimal",
      "projectAmount": "decimal"
    },
    "Labels": {
      "sourceId": "Source ID",
      "sourceName": "Lead Source",
      "leadCount": "Total Leads",
      "qualifiedCount": "Qualified",
      "wonCount": "Won",
      "conversionPercent": "Conversion %",
      "projectAmount": "Project Amount (KWD)"
    },
    "Formats": {
      "conversionPercent": "=Format(Fields!conversionPercent.Value, \"0.00\") & \"%\"",
      "projectAmount": "=Format(Fields!projectAmount.Value, \"N3\")"
    }
  },
  "source-details": {
    "Title": "Source-wise Lead Details",
    "Columns": {
      "sourceName": "string",
      "customerCode": "string",
      "customerName": "string",
      "assignedUser": "string",
      "leadStatus": "string",
      "projectAmount": "decimal",
      "createdAtUtc": "date"
    },
    "Labels": {
      "sourceName": "Lead Source",
      "customerCode": "Customer Code",
      "customerName": "Customer Name",
      "assignedUser": "Assigned Employee",
      "leadStatus": "Lead Status",
      "projectAmount": "Project Amount (KWD)",
      "createdAtUtc": "Created At (UTC)"
    },
    "Formats": {
      "projectAmount": "=IIf(IsNothing(Fields!projectAmount.Value), \"\", Format(Fields!projectAmount.Value, \"N3\"))",
      "createdAtUtc": "=Format(Fields!createdAtUtc.Value, \"dd MMM yyyy\")"
    }
  }
}
